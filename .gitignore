# ===== Android 平台工程 =====
# Phase A 起 android/ 入库（含 Kotlin 自定义代码），仅忽略生成物与本地配置。
/android/local.properties
/android/.gradle/
/android/**/build/
/android/**/captures/
/android/**/.cxx/
# gradle-wrapper.jar 是二进制，由 flutter create 生成，不入库
/android/**/gradle-wrapper.jar
# 模型文件由 tools/fetch_models.sh 从 ModelScope 下载，不入库
/android/app/src/main/assets/models/

